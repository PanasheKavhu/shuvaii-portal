# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Never import in client code, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-ONLY. Turns learner PINs into their Auth passwords (D26); at least
# 32 random characters, e.g. `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`.
# Changing it stops every learner PIN working until an admin resets them.
LEARNER_PIN_SECRET=

# SERVER-ONLY. The portal's public address; report QR codes point to
# SITE_URL/verify/<code> (D45). Leave empty locally to use the request's address.
SITE_URL=

# SERVER-ONLY. Where Supabase stores the data, in plain words, printed on the
# privacy notice (D57), e.g. "Frankfurt, Germany (AWS eu-central-1)".
DATA_REGION=

# SERVER-ONLY. The scheduler's secret for /api/cron/retention (D58); at least
# 32 random characters. Vercel Cron sends it as `Authorization: Bearer ...`.
CRON_SECRET=

# Error reporting with Sentry (D59). Leave empty to send nothing (local, CI).
# SENTRY_DSN is read on the server, NEXT_PUBLIC_SENTRY_DSN in the browser;
# both are the same DSN. NEXT_PUBLIC_SENTRY_ENVIRONMENT names the deployment
# (production, staging).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
